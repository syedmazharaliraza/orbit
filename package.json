{
  "name": "orbit-stage-one",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit Stage 1 floating visual shell",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run build:collector && env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "npm run build:collector && electron-vite build",
    "build:collector": "mkdir -p .build && swiftc -O -framework CryptoKit native/OrbitHookCollector/main.swift -o .build/orbit-claude-hook-collector",
    "hooks:preview": "node scripts/claude-hooks.mjs",
    "hooks:install": "node scripts/claude-hooks.mjs --apply",
    "hooks:uninstall": "node scripts/claude-hooks.mjs --uninstall",
    "test:hooks": "mkdir -p .build && esbuild test/hooks.test.ts --bundle --platform=node --format=cjs --outfile=.build/hooks.test.cjs && node .build/hooks.test.cjs && esbuild test/session-opener.test.ts --bundle --platform=node --format=cjs --outfile=.build/session-opener.test.cjs && node .build/session-opener.test.cjs",
    "preview": "electron-vite preview",
    "package:mac": "npm run build && electron-builder --mac --arm64",
    "test:preview": "npm run build && env -u ELECTRON_RUN_AS_NODE electron test/preview.electron.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/plus-jakarta-sans": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "build": {
    "appId": "com.orbit.mission-control",
    "productName": "Orbit",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".build/orbit-claude-hook-collector",
        "to": "orbit-claude-hook-collector"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "arch": [
        "arm64"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
